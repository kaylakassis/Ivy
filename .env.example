# ─── Required ────────────────────────────────────────────────────────
# Without these the app won't boot or first signup will throw.

# Database (Neon, the native Vercel Postgres successor). Use the
# connection string from your Vercel → Storage → Neon integration.
DATABASE_URL=
POSTGRES_URL=                       # Some hosts auto-set this; either works.

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Admin (one-time DB migration + impersonation)
ADMIN_SECRET=change-me-to-a-long-random-string
SUPER_ADMIN_EMAIL=you@example.com   # Account auto-promoted to admin.

# Cron auth - required in production. The cron handlers refuse to run
# (or accept "Bearer undefined" as valid auth) without it.
CRON_SECRET=change-me-to-a-long-random-string

# Encryption key for at-rest secrets (Stripe Connect tokens, Google
# refresh tokens, etc.). 32+ random bytes hex-encoded recommended.
SECRETS_KEY=change-me-to-a-long-random-string

# Public app origin used for canonical share URLs (booking links, sign
# links, invoice links). Production: https://joinivy.ai
APP_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# ─── Email (Resend) ──────────────────────────────────────────────────
# Welcome / verification / invoice / booking emails all flow through
# Resend. Without RESEND_API_KEY every email-sending route throws.
RESEND_API_KEY=
EMAIL_FROM=Ivy OS <hello@joinivy.ai>      # Don't use "noreply@" - penalized by spam filters.
EMAIL_REPLY_TO=hello@joinivy.ai

# ─── Stripe (platform Stripe account) ────────────────────────────────
# Ivy OS's own Stripe account - used for both:
#   1. Subscription billing (the $X/mo each owner pays Ivy OS)
#   2. Stripe Connect platform credentials (so connected owner accounts
#      can charge their own clients through Ivy OS).
#
# Connect Stripe in Vercel → Storage → Stripe to auto-inject:
#   STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET.
# The legacy IVY_STRIPE_SECRET / STRIPE_PLATFORM_SECRET names still
# work as fallbacks; new deploys should use the Vercel-injected ones.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=          # From the Stripe → Settings → Connect "Connect platform" page.
IVY_STRIPE_PRICE_ID=            # The Price object for Ivy OS's monthly plan.
IVY_PLAN_MONTHLY_CENTS=3900     # Display price; Stripe is source of truth.

# ─── Twilio (SMS) ────────────────────────────────────────────────────
# Reminders + 2-way messaging. Optional: SMS features no-op gracefully
# without these.
IVY_TWILIO_ACCOUNT_SID=
IVY_TWILIO_AUTH_TOKEN=
IVY_TWILIO_FROM_NUMBER=

# ─── Web Push ────────────────────────────────────────────────────────
# Browser push notifications. Generate via `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@joinivy.ai

# ─── Anthropic (Ivy) ─────────────────────────────────────────────────
# Optional - Ivy falls back to a deterministic mock if missing, but
# the assistant won't actually reason without it.
ANTHROPIC_API_KEY=

# ─── Square (optional, per-workspace) ────────────────────────────────
# Workspaces that pick Square as their checkout provider OAuth-connect
# their merchant account through these credentials. App-level - same
# values across all workspaces. Without these, Square stays hidden in
# the provider picker.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=production         # 'sandbox' for dev/staging
SQUARE_REDIRECT_URI=                  # https://<your domain>/api/finance/square-oauth-callback
SQUARE_WEBHOOK_SIGNATURE_KEY=         # From Square Developer Dashboard → Webhooks

# ─── PayPal (optional, per-workspace) ────────────────────────────────
# Workspaces that pick PayPal connect via PayPal Commerce. App-level -
# same values across workspaces. Without these, PayPal stays hidden.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live               # 'sandbox' for dev/staging
PAYPAL_PARTNER_ID=                    # BN code / partner attribution
PAYPAL_WEBHOOK_ID=                    # From PayPal Dashboard → Webhooks

# ─── Google Calendar (busy-sync + OAuth) ─────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Vercel Blob (document storage / signing) ────────────────────────
# Required for document upload + e-signature audit PDFs.
BLOB_READ_WRITE_TOKEN=

# ─── Custom domains (business-owner website builder) ─────────────────
# The CNAME owners point their domain at (defaults to cname.joinivy.ai).
WEBSITE_CNAME_TARGET=cname.joinivy.ai
# To AUTO-attach a verified custom domain to this Vercel project (so it's
# actually served + gets a cert), set a Vercel API token + the project id.
# Without these, DNS verification still works but you must add each
# verified domain to the Vercel project manually (Settings → Domains).
VERCEL_TOKEN=                 # Vercel account/team API token (vercel.com/account/tokens)
VERCEL_PROJECT_ID=            # Project → Settings → General → Project ID
VERCEL_TEAM_ID=               # Only if the project lives under a Team

# ─── Sentry (error tracking) ─────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
